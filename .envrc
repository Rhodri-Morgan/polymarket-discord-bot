# direnv: loads local secrets from AWS SSM Parameter Store and writes a .env file
# for the Docker `--env-file .env` workflow. Run `direnv allow` after editing.

set -euo pipefail

if ! command -v aws >/dev/null 2>&1; then
  echo "direnv: aws CLI is required" >&2
  exit 1
fi

export AWS_PROFILE=rtm
export AWS_REGION=eu-west-1
export HEALTH_PORT=4000

# DISCORD_BOT_TOKEN + DISCORD_CHANNEL_ID — local-only SecureStrings
export DISCORD_BOT_TOKEN=$(aws ssm get-parameter --name local-eu-west-1-polymarket-discord-bot-discord-bot-token \
  --region "$AWS_REGION" --with-decryption \
  --query Parameter.Value --output text)
export DISCORD_CHANNEL_ID=$(aws ssm get-parameter --name local-eu-west-1-polymarket-discord-bot-discord-channel-id \
  --region "$AWS_REGION" --with-decryption \
  --query Parameter.Value --output text)

# Mirror the exported vars into a .env file so `make docker-*` (which uses
# `--env-file .env`) picks them up. .env is gitignored.
cat > .env <<EOF
HEALTH_PORT=$HEALTH_PORT
DISCORD_BOT_TOKEN=$DISCORD_BOT_TOKEN
DISCORD_CHANNEL_ID=$DISCORD_CHANNEL_ID
EOF
